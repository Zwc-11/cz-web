{
  "name": "cz-web",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server/index.js",
    "test": "npm run typecheck --workspace client && npm run test:portfolio",
    "test:portfolio": "node --experimental-strip-types --test scripts/project-navigation.test.mjs",
    "install:all": "npm install"
  },
  "engines": { "node": ">=22.12.0" }
}
